{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tetra-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/src/server.js",
        "--mock"
      ],
      "port": 4000
    },
    {
      "name": "tetra-frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "tetra-mock-alt-port",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/src/server.js",
        "--mock",
        "--http",
        "4100"
      ],
      "port": 4100
    }
  ]
}
